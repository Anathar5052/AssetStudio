<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0</TargetFrameworks>
    <Version>0.16.0.0</Version>
    <AssemblyVersion>0.16.0.0</AssemblyVersion>
    <FileVersion>0.16.0.0</FileVersion>
    <Copyright>Copyright © Perfare 2018-2022</Copyright>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Références pour .NET 9 -->
  <ItemGroup Condition=" '$(TargetFramework)' != 'net472' ">
    <!-- LZ4 classique -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.2" />
    <!-- Ajout du support des Streams LZ4 -->
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.2" />
  </ItemGroup>

  <!-- Références pour .NET Framework 4.7.2 -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="System.Memory" Version="4.5.4" />
    <PackageReference Include="System.IO.Compression" Version="4.0.0" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.1.11" />
  </ItemGroup>

  <!-- xxHash utilisé par AssetStudio -->
  <ItemGroup>
    <PackageReference Include="K4os.Hash.xxHash" Version="1.0.8" />
  </ItemGroup>

</Project>
