<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Utilisation de TargetFramework (singulier) -->
    <TargetFramework>net9.0</TargetFramework>
    <Version>0.16.0.0</Version>
    <AssemblyVersion>0.16.0.0</AssemblyVersion>
    <FileVersion>0.16.0.0</FileVersion>
    <Copyright>Copyright © Perfare 2018-2022</Copyright>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Références pour .NET 9 -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
    <!-- LZ4 + Streams -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.6" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.6" />
    <!-- Nécessaire pour K4os -->
    <PackageReference Include="System.Buffers" Version="4.5.1" />
  </ItemGroup>

  <!-- Références pour .NET Framework 4.7.2 -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.6" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.6" />
  </ItemGroup>

  <!-- xxHash utilisé par AssetStudio -->
  <ItemGroup>
    <PackageReference Include="K4os.Hash.xxHash" Version="1.0.8" />
  </ItemGroup>

</Project>
